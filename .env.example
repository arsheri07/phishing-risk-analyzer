# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file - it's already in .gitignore.

# Optional. Get a free key at:
# https://developers.google.com/safe-browsing/v4/get-started
# If left unset, the app works fully without this - it just skips
# the Safe Browsing check on the Website tab.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional. Flask/gunicorn port - defaults to 5000 if unset.
PORT=
